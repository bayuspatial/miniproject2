# ==============================================================================
# Example Environment Configuration (.env.example)
# Salin file ini menjadi .env lalu isi nilainya sesuai environment Anda:
#   cp .env.example .env
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://peserta:PASSWORD@84.247.146.224:5432/sandbox

# Identitas Siswa / Schema Prefix
STUDENT_NAME=your_student_id

# Autentikasi Internal API Key
INTERNAL_API_KEY=your_internal_api_key_here

# JWT Secret & Token Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY_MINUTES=30

# OAuth Client Credentials (POST /token)
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
