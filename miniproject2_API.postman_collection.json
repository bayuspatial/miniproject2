              "pm.test(\"Filter source & date_from berhasil diaplikasikan\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data).to.be.an(\"array\");",
              "    pm.expect(json.total_items).to.be.above(0);",
              "    if (json.data.length > 0) {",
              "        pm.expect(json.data[0].source.toLowerCase()).to.eql(\"quotes.toscrape\");",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
