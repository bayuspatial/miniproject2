    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Get JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set(\"jwt_token\", json.access_token);",
                  "    pm.test(\"Token saved to collection variable\", function() {",
                  "        pm.expect(json.access_token).to.be.a(\"string\");",
                  "        pm.expect(json.token_type).to.eql(\"bearer\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"client_id\": \"{{client_id}}\",\n    \"client_secret\": \"{{client_secret}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "Exchange client credentials (client_id & client_secret) untuk mendapatkan JWT token.\n\nScript test otomatis menyimpan token ke collection variable `jwt_token` sehingga request di folder JWT bisa langsung dijalankan."
          }
