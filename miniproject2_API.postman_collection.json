    {
      "name": "1. GET /articles/search - tanpa filter (default pagination)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Default pagination berjalan (page 1, per_page 10)\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"data\");",
              "    pm.expect(json.page).to.eql(1);",
              "    pm.expect(json.per_page).to.eql(10);",
              "    pm.expect(json.total_items).to.be.above(0);",
              "    pm.expect(json.data).to.be.an(\"array\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/articles/search",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "articles",
            "search"
          ]
        },
        "description": "1. Mengambil artikel dengan default pagination tanpa filter tambahan (default page=1, per_page=10)."
      }
    },
    {
      "name": "2. GET /articles/search - dengan filter source + date_from",
      "event": [
        {
          "listen": "test",
