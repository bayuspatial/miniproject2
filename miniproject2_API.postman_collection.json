    {
      "name": "7. POST /token atau GET dengan API Key - bukti auth berjalan",
      "item": [
        {
          "name": "7.1 POST /token (Exchange Credentials -> JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set(\"jwt_token\", json.access_token);",
                  "    pm.test(\"Access token JWT berhasil diperoleh dan disimpan\", function () {",
                  "        pm.expect(json.access_token).to.be.a(\"string\");",
                  "        pm.expect(json.token_type).to.eql(\"bearer\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n    \"client_id\": \"{{client_id}}\",\\n    \"client_secret\": \"{{client_secret}}\"\\n}"
            },
            "url": {
              "raw": "{{base_url}}/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "7.1 Bukti Autentikasi JWT: Login menggunakan client_id & client_secret untuk menghasilkan Bearer token."
          }
        },
        {
          "name": "7.2 GET /articles/stats (Akses Menggunakan API Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 (Autentikasi API Key Berhasil)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/articles/stats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "articles",
                "stats"
              ]
            },
            "description": "7.2 Bukti Autentikasi API Key: Endpoint terproteksi berhasil diakses dengan header X-API-Key valid."
          }
        },
        {
          "name": "7.3 GET /articles/stats (Uji Validasi Tanpa Auth -> Reject 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized (Proteksi Auth Berjalan)\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/articles/stats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "articles",
                "stats"
              ]
            },
            "description": "7.3 Bukti Sistem Proteksi Auth: Request tanpa kredensial otomatis ditolak dengan kode 401 Unauthorized."
          }
        }
      ],
      "description": "7. Bukti mekanisme keamanan dan autentikasi API berjalan (JWT Bearer Token dan API Key)."
